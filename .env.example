# Database Configuration for Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=YourSecureDbPassword
POSTGRES_DB=VehicleServiceDb
POSTGRES_PORT=5433

# ASP.NET Core Nested Configuration Overrides (Section__Key convention)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=VehicleServiceDb;Username=admin;Password=YourSecureDbPassword
JwtSettings__SecretKey=ReplaceWithAStrongRandom64CharacterKeyForProductionEnvironment123456
JwtSettings__Issuer=VehicleServiceAPI
JwtSettings__Audience=VehicleServiceClient
JwtSettings__ExpiryMinutes=60
